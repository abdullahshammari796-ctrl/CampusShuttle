# Example configuration — copy to .env only if your launcher loads it, or set these as
# environment variables. Every value here is a placeholder or the built-in default.
# Never commit or share a real .env file.

HOST=127.0.0.1
PORT=3000
DB_FILE=./data/campus-shuttle.db

# Token signing key (at least 32 characters). If unset, a random one is generated
# into data/session-secret on first start.
SESSION_SECRET=replace-with-a-long-random-value-of-at-least-32-characters

# Set to true only when the app is served over HTTPS.
SECURE_COOKIES=false
SEED_ON_EMPTY=true

STALE_AFTER_SECONDS=20
LOST_AFTER_SECONDS=60
ABANDON_AFTER_MINUTES=30
LOCATION_RETENTION_DAYS=30
ETA_STRATEGY=blended-speed
