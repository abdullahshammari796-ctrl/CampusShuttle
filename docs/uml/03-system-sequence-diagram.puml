@startuml 03-system-sequence-diagram
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
title System sequence diagram — UC2 Run a trip (main success scenario)
autonumber

actor Driver
participant ":Campus Shuttle System" as System

Driver -> System : getTripOptions()
System --> Driver : routes[], shuttles[](busy)
Driver -> System : startTrip(routeId, shuttleId)
System --> Driver : trip(tripId, status = ACTIVE), vehicle(signal = AWAITING_FIX)

par while the trip is active
  loop every ~3 s (queued positions are sent together)
    Driver -> System : sendLocations(tripId, fixes[], sentAt)
    System --> Driver : result(accepted, rejected[], vehicle(nextStop, eta, signal))
  end
else
  loop every 5 s
    Driver -> System : getTrip()
    System --> Driver : vehicle(signal, nextStop, eta), locationSource
  end
end

note right of System
  The signal is what passengers see:
  LIVE, STALE after 20 s or LOST after
  60 s without an accepted position.
end note

opt the passenger load changes
  Driver -> System : setOccupancy(tripId, level)
  System --> Driver : trip(occupancy)
end

Driver -> System : endTrip(tripId)
System --> Driver : trip(status = COMPLETED)
@enduml
