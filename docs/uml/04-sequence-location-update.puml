@startuml 04-sequence-location-update
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
<style>
sequenceDiagram {
  group {
    FontSize 13
  }
}
</style>
title Design sequence diagram — processing one location upload (inside the system)

participant ":Location\nUploader\n(driver browser)" as App
participant ":driver\nRoutes\n(web)" as Web
participant ":Tracking\nService" as TS
participant ":TripTracker" as TT
participant ":LocationFix\nRepository" as Repo
participant ":EventBus" as Bus
participant ":Waiting\nService" as WS
participant ":SseHub" as Hub
participant ":LiveView" as LV
participant ":EtaStrategy\n(BlendedSpeedEta\nby default)" as Eta
participant "Viewer\nbrowsers" as Viewers

App -> Web : POST /api/driver/\ntrips/{id}/locations\n{fixes[], sentAt}
Web -> TS : recordFixes(driverId,\ntripId, fixes, sentAt)
TS -> TS : parse, correct clock skew,\nfilter accuracy, service\narea and age
TS -> TT : validateSequence(candidates)
TT --> TS : accepted[], rejected[]
opt accepted is not empty
  TS -> Repo : appendMany(accepted)
  loop for each accepted fix
    TS -> TT : apply(fix)
    TT --> TS : stopsReached[]
  end
  TS -> TT : tick(now, thresholds)
  TS -> Bus : publish(trip.location)
  Bus -> Hub : queueVehicle(tripId)
  opt signal status changed
    TS -> Bus : publish(trip.signal)
    Bus -> Hub : queueVehicle(tripId)
  end
  loop for each stop reached
    TS -> Bus : publish(stop.arrived)
    Bus -> WS : markServed(stopId, routeId)
    Bus -> Hub : broadcast(arrival)
  end
end
TS -> Eta : estimate(context)
Eta --> TS : StopEta[]
TS --> Web : RecordFixesResult
Web --> App : 200 {accepted,\nrejected[], vehicle}

== next event-loop turn (coalesces all updates of this batch) ==
Hub -> LV : vehicle(tripId)
LV -> TS : vehicle(tripId)
TS --> LV : VehicleView
LV --> Hub : VehicleView
Hub ->> Viewers : SSE "vehicle"\n(serialised once,\nwritten to every\nconnection whose\nsession has not\nexpired)
@enduml
