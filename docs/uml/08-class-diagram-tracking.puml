@startuml 08-class-diagram-tracking
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
title Design class diagram (1 of 2) — network, tracking and real-time components

package "network" {
  class Route <<record>> {
    +id: string
    +name: string
    +color: string
    +stopIds: string[]
    +path: GeoPoint[]
    +loop: boolean
    +nominalSpeedKmh: number
    +dwellSeconds: number
    +active: boolean
    +updatedAt: number
  }
  class RoutePath {
    +loop: boolean
    +length: number
    +stops: StopOffset[]
    +project(p: GeoPoint, window?: AlongWindow): Projection
    +pointAt(distanceAlong: number): GeoPoint
    +distanceAhead(from: number, to: number): number | null
    +signedDelta(from: number, to: number): number
    +upcomingStops(distanceAlong: number): UpcomingStop[]
    +stopsReached(from: number | null, to: number, radius: number): string[]
    +points(): GeoPoint[]
  }
  class StopOffset <<record>> {
    +stopId: string
    +sequence: number
    +distanceAlong: number
  }
  interface NetworkReader {
    +getRoute(id: string): Route | null
    +getStop(id: string): Stop | null
    +getShuttle(id: string): Shuttle | null
    +listStops(): Stop[]
    +listRoutes(options?: {includeInactive?}): Route[]
    +pathFor(routeId: string): RoutePath
    +serviceArea(): {center, radiusMeters}
  }
  class NetworkService {
    +listShuttles(): Shuttle[]
    +updateRoute(actorId: string, id: string, patch: RoutePatch): Route
    +createRoute(actorId: string, input: NewRouteInput): Route
  }
}

package "tracking" {
  class Trip <<record>> {
    +id: string
    +routeId: string
    +shuttleId: string
    +driverId: string
    +status: TripStatus
    +occupancy: OccupancyLevel
    +startedAt: number
    +endedAt: number | null
    +endReason: string | null
  }
  class LocationFix <<record>> {
    +tripId: string
    +lat: number
    +lng: number
    +speedKmh: number | null
    +headingDeg: number | null
    +accuracyM: number | null
    +recordedAt: number
    +receivedAt: number
    +source: FixSource
  }
  class TrackingService {
    -trackers: Map<string, TripTracker>
    +recover(): number
    +startTrip(driverId: string, input: {routeId, shuttleId}): Trip
    +recordFixes(driverId: string, tripId: string, fixes, sentAt?): RecordFixesResult
    +setOccupancy(driverId: string, tripId: string, level): Trip
    +endTrip(driverId: string, tripId: string): Trip
    +terminateTrip(actorId: string, tripId: string, reason: unknown): Trip
    +checkSignals(): {changed: number, closed: number}
    +liveVehicles(): VehicleView[]
    +vehicle(tripId: string): VehicleView | null
    +activeTripFor(driverId: string): VehicleView | null
    +lastFixSource(tripId: string): FixSource | null
    +isShuttleBusy(shuttleId: string): boolean
    +signalSummary(): Record<SignalStatus, number>
    +arrivalsAt(stopId: string): ArrivalView[]
    +officeTrips(): OfficeTripView[]
    +tripHistory(options: {limit, status?}): TripHistoryItem[]
    +tripTrack(tripId: string): TripTrack
    +purgeFixesOlderThan(days: number): number
  }
  class TripTracker {
    +distanceAlong: number | null
    +snapped: GeoPoint | null
    +offRouteMeters: number | null
    +speedMps: number | null
    +speedSamples: number
    +validateSequence(candidates): {accepted, rejected}
    +apply(fix: LocationFix): string[]
    +restore(fix: LocationFix): void
    +tick(now: number, thresholds: SignalThresholds): boolean
    +ageMs(now: number): number
    +etaContext(route: Route): EtaContext | null
  }
  interface SignalState <<state>> {
    +status: SignalStatus
    +etaConfidence: EtaConfidence
    +onFix(): SignalState
    +onTick(ageMs: number, t: SignalThresholds): SignalState
    +present(etas: StopEta[], now: number): PresentedEta[]
    +message(ageMs: number): string
  }
  interface EtaStrategy <<strategy>> {
    +id: string
    +description: string
    +estimate(ctx: EtaContext): StopEta[]
  }
  class BlendedSpeedEta {
    +estimate(ctx: EtaContext): StopEta[]
  }
  interface TripRepository <<repository>> {
    +insert(trip: Trip): void
    +update(trip: Trip): void
    +get(id: string): Trip | null
    +listActive(): Trip[]
    +listRecent(options: {limit, status?}): Trip[]
  }
  interface LocationFixRepository <<repository>> {
    +appendMany(fixes: LocationFix[]): void
    +lastForTrip(tripId: string): LocationFix | null
    +listForTrip(tripId: string): LocationFix[]
    +purgeOlderThan(cutoffMs: number): number
  }
  interface UserDirectory {
    +displayName(userId: string): string | null
  }
  class VehicleView <<record>> {
    +tripId: string
    +routeName: string
    +shuttleLabel: string
    +position: GeoPoint | null
    +signal: {status, lastFixAt, message, etaConfidence}
    +nextStops: PresentedEta[]
  }
}

package "shared" {
  interface "EventPublisher<E>" as EventPublisher {
    +publish(event: E): void
  }
  class "EventBus<DomainEvent>" as EventBus {
    +subscribe(type, handler: (event) => void): () => void
    +publish(event: DomainEvent): void
  }
  interface AuditLog {
    +record(entry): void
    +recent(limit: number): AuditEntry[]
  }
}

package "realtime" {
  class SseHub {
    -clients: Map<number, Client>
    -pendingVehicles: Set<string>
    +attach(req, res, role: Role, sessionExpiresAt: number): void
    +startHeartbeat(): void
    +expireSessions(): number
    +flush(): void
    +stats(): {clients, byRole, messagesSent, ...}
    +close(): void
  }
  interface LiveDataSource {
    +snapshot(role: Role): {vehicles, waiting}
    +vehicle(tripId: string): VehicleView | null
  }
  class LiveView
}

NetworkService ..|> NetworkReader
NetworkService "1" --> "0..*" RoutePath : caches >
RoutePath "1" *-- "2..*" StopOffset
Route "1" ..> "1" RoutePath : geometry of <

TrackingService "1" *-- "0..*" TripTracker : trackers
TrackingService --> "1" NetworkReader
TrackingService --> "1" EtaStrategy : eta
TrackingService --> "1" TripRepository
TrackingService --> "1" LocationFixRepository
TrackingService --> "1" UserDirectory : users
TrackingService --> "1" EventPublisher : publishes to
TrackingService --> "1" AuditLog : audit
TrackingService ..> VehicleView : creates
TripTracker "0..1" --> "1" Trip : trip
TripTracker "0..*" --> "1" RoutePath : path
TripTracker "0..*" --> "1" SignalState : signal
TripTracker "1" --> "0..1" LocationFix : lastFix
Trip "1" -- "0..*" LocationFix
BlendedSpeedEta ..|> EtaStrategy
EventBus ..|> EventPublisher

LiveView ..|> LiveDataSource
LiveView --> "1" TrackingService
SseHub --> "1" LiveDataSource
SseHub ..> EventBus : subscribes callbacks to

note bottom of LiveView
  Also reads waiting counts from
  demand.WaitingService (diagram 09).
  NetworkService also implements the
  NetworkReader operations it lists there.
end note
note "Type names written as {…} are inline TypeScript object types; there is no named class for them." as N1
@enduml
